# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in your free-tier keys. `.env` is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# Google AI Studio — Gemini 2.5 Flash (generation) + gemini-embedding-001 (embeddings)
# Get a free key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Groq — Llama 3.3 70B for fast routing decisions
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=

# Neo4j Aura (free tier) — used from Part 3 (knowledge graph)
# Create a free instance at: https://neo4j.com/cloud/aura-free/
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# OMDB — structured film metadata (Part 1). TMDB is geo-blocked in some regions
# (incl. India), so we use OMDB as the structured data source instead.
# Get a free key at: http://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# ─── Models & config (sensible defaults — usually no need to change) ───
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# ─── Paths ───
DATA_DIR=./data
SQLITE_PATH=./data/memory.db
